%{

#include <iostream>
using namespace std;

%}


%code requires 
{

#include "assembler.hpp"

}

%code provides 
{

yy::parser::symbol_type yylex();

}

%require "3.2"
%language "c++"
%skeleton "lalr1.cc"


%define api.token.raw

%define api.token.constructor
%define api.value.type variant
%define parse.assert

%locations
%define api.location.file "../../inc/assembler/loc.hpp"
%define api.location.include {"loc.hpp"}

%define parse.trace
%define parse.error verbose
%define parse.lac full

%parse-param { Assembler& assembler }



%token ASMD_GLOBAL ASMD_EXTERN ASMD_SECTION ASMD_WORD ASMD_SKIP ASMD_END ASMD_ASCII ASMD_EQU

%token INST_HALT INST_INT INST_IRET
%token INST_CALL INST_RET
%token INST_JMP INST_BEQ INST_BNE INST_BGT
%token INST_PUSH INST_POP INST_LD INST_ST
%token INST_ADD INST_SUB INST_MUL INST_DIV
%token INST_NOT INST_AND INST_OR INST_XOR INST_SHL INST_SHR
%token INST_XCHG INST_CSRRD INST_CSRWR

%token <int> GPR CSR

%token COLON COMMA IMM_PREFIX L_BRACKET R_BRACKET YYEOL
%token PLUS MINUS MUL DIV

%token <int> NUM_LITERAL
%token <string> SYMBOL STR_LITERAL

%%

%start program;

program:        lines ASMD_END { YYACCEPT; };

lines:          %empty
                |
                lines line
                ;

line:           directive YYEOL 
                |
                inst_line YYEOL
                |
                label YYEOL
                |
                YYEOL 
                ;

directive:      ASMD_GLOBAL { assembler.set_cpdir(Assembler::DIR::GLOBAL); } symbol_list { assembler.set_cpdir(Assembler::DIR::NONE); }
                |
                ASMD_EXTERN { assembler.set_cpdir(Assembler::DIR::EXTERN); } symbol_list { assembler.set_cpdir(Assembler::DIR::NONE); }
                |
                ASMD_SECTION SYMBOL[section_name] { assembler.start_new_section($section_name); }
                |
                ASMD_WORD sym_lit_list
                |
                ASMD_SKIP NUM_LITERAL[num_lit] { assembler.skip_bytes($num_lit); }
                |
                ASMD_ASCII STR_LITERAL[str_lit] { assembler.emit_string($str_lit); }
                |
                ASMD_EQU SYMBOL[new_symbol] COMMA NUM_LITERAL[val]
                ;


symbol_list:    SYMBOL[symbol_name] { assembler.process_symbol($symbol_name); }
                |
                symbol_list COMMA SYMBOL[symbol_name] { assembler.process_symbol($symbol_name); }
                ;

sym_lit_list:   SYMBOL[symbol_name] { assembler.emit_symbol($symbol_name); }
                |
                NUM_LITERAL[num_lit] { assembler.emit_num_literal($num_lit); }
                |
                sym_lit_list COMMA SYMBOL[symbol_name] { assembler.emit_symbol($symbol_name); }
                |
                sym_lit_list COMMA NUM_LITERAL[num_lit] { assembler.emit_num_literal($num_lit); }
                ;


label:          SYMBOL[symbol_name] COLON { assembler.process_symbol($symbol_name); } ;


inst_line:      label instruction
                |
                instruction
                ;


instruction:    INST_HALT { assembler.process_halt(); }
                |
                INST_INT { assembler.process_int(); }
                |
                INST_IRET { assembler.process_iret(); }
                |
                INST_CALL dest_operand { assembler.process_call(); }
                |
                INST_RET { assembler.process_ret(); }
                |
                INST_JMP dest_operand { assembler.process_jump(Assembler::JUMP_TYPE::JMP); }
                |
                INST_BEQ GPR COMMA GPR COMMA dest_operand { assembler.process_jump(Assembler::JUMP_TYPE::BEQ, static_cast<Assembler::OP_GPR>($2), static_cast<Assembler::OP_GPR>($4)); }
                |
                INST_BNE GPR COMMA GPR COMMA dest_operand { assembler.process_jump(Assembler::JUMP_TYPE::BNE, static_cast<Assembler::OP_GPR>($2), static_cast<Assembler::OP_GPR>($4)); }
                |
                INST_BGT GPR COMMA GPR COMMA dest_operand { assembler.process_jump(Assembler::JUMP_TYPE::BGT, static_cast<Assembler::OP_GPR>($2), static_cast<Assembler::OP_GPR>($4)); }
                |
                INST_PUSH GPR { assembler.process_push(static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_POP GPR { assembler.process_pop(static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_XCHG GPR COMMA GPR { assembler.process_xchg(static_cast<Assembler::OP_GPR>($2), static_cast<Assembler::OP_GPR>($4)); }
                |
                INST_ADD GPR COMMA GPR { assembler.process_arth(Assembler::ARTH_TYPE::ADD, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_SUB GPR COMMA GPR { assembler.process_arth(Assembler::ARTH_TYPE::SUB, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_MUL GPR COMMA GPR { assembler.process_arth(Assembler::ARTH_TYPE::MUL, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_DIV GPR COMMA GPR { assembler.process_arth(Assembler::ARTH_TYPE::DIV, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_NOT GPR { assembler.process_log(Assembler::LOG_TYPE::NOT, static_cast<Assembler::OP_GPR>($2), Assembler::OP_GPR::GPR_0); }
                |
                INST_AND GPR COMMA GPR { assembler.process_log(Assembler::LOG_TYPE::AND, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_OR GPR COMMA GPR { assembler.process_log(Assembler::LOG_TYPE::OR, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_XOR GPR COMMA GPR { assembler.process_log(Assembler::LOG_TYPE::XOR, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_SHL GPR COMMA GPR { assembler.process_sh(Assembler::SH_TYPE::LEFT_SH, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_SHR GPR COMMA GPR { assembler.process_sh(Assembler::SH_TYPE::RIGHT_SH, static_cast<Assembler::OP_GPR>($4), static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_LD operand COMMA GPR { assembler.process_ld(static_cast<Assembler::OP_GPR>($4)); }
                |
                INST_ST GPR COMMA operand { assembler.process_st(static_cast<Assembler::OP_GPR>($2)); }
                |
                INST_CSRRD CSR COMMA GPR { assembler.process_csr_op(Assembler::CSR_OP_TYPE::CSR_RD, static_cast<Assembler::OP_CSR>($2), static_cast<Assembler::OP_GPR>($4)); }
                |
                INST_CSRWR GPR COMMA CSR { assembler.process_csr_op(Assembler::CSR_OP_TYPE::CSR_WR, static_cast<Assembler::OP_CSR>($4), static_cast<Assembler::OP_GPR>($2)); }
                ;


dest_operand:   NUM_LITERAL[num_lit] { assembler.prepare_operand(Assembler::OPERAND_TYPE::LIT, $num_lit, "", -1); } 
                |
                SYMBOL[symbol_name] { assembler.prepare_operand(Assembler::OPERAND_TYPE::SYM, 0, $symbol_name, -1); } 
                ;

operand:        IMM_PREFIX NUM_LITERAL[num_lit] { assembler.prepare_operand(Assembler::OPERAND_TYPE::LIT, $num_lit, "", -1); } 
                |
                IMM_PREFIX SYMBOL[symbol_name] { assembler.prepare_operand(Assembler::OPERAND_TYPE::SYM, 0, $symbol_name, -1); } 
                |
                NUM_LITERAL[num_lit] { assembler.prepare_operand(Assembler::OPERAND_TYPE::LIT_IND, $num_lit, "", -1); } 
                |
                SYMBOL[symbol_name] { assembler.prepare_operand(Assembler::OPERAND_TYPE::SYM_IND, 0, $symbol_name, -1); } 
                |
                GPR { assembler.prepare_operand(Assembler::OPERAND_TYPE::GPR, 0, "", $1); } 
                |
                L_BRACKET GPR R_BRACKET { assembler.prepare_operand(Assembler::OPERAND_TYPE::GPR_IND, 0, "", $2); } 
                |
                L_BRACKET GPR PLUS NUM_LITERAL R_BRACKET { assembler.prepare_operand(Assembler::OPERAND_TYPE::GPR_LIT_DISP, $4, "", $2); } 
                |
                L_BRACKET GPR PLUS SYMBOL R_BRACKET { assembler.prepare_operand(Assembler::OPERAND_TYPE::GPR_SYM_DISP, 0, $4, $2); } 
                ;

%%


void yy::parser::error(const yy::location& l, const std::string& m)
{
    std::cerr << l << ": " << m << std::endl;
}